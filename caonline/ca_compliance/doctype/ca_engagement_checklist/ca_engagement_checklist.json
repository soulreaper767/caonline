   "fieldtype": "Link",
   "options": "CA Engagement",
   "label": "Engagement",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "checklist_template",
   "fieldtype": "Link",
   "options": "CA Compliance Checklist Template",
   "label": "Source Template",
   "read_only": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "total_items",
   "fieldtype": "Int",
   "label": "Total Items",
   "read_only": 1
  },
  {
   "fieldname": "completed_items",
   "fieldtype": "Int",
