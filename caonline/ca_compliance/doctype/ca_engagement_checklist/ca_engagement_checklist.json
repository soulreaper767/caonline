   "options": "CA Engagement Checklist Item",
   "label": "Items"
  }
 ],
 "permissions": [
  {"role": "CA Partner", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1},
  {"role": "CA Manager", "read": 1, "write": 1, "create": 1, "report": 1},
  {"role": "CA Department Supervisor", "read": 1, "write": 1},
  {"role": "CA Job Incharge", "read": 1, "write": 1},
  {"role": "CA Senior Trainee", "read": 1, "write": 1},
  {"role": "CA Junior Trainee", "read": 1, "write": 1},
  {"role": "CA QCR Reviewer", "read": 1}
 ]
}
