{
 "doctype": "DocType",
 "name": "CA Working Paper",
 "module": "CA Core",
 "engine": "InnoDB",
 "autoname": "format:WP-{engagement}-{#####}",
 "title_field": "title",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "core_section",
   "fieldtype": "Section Break",
   "label": "Working Paper"
  },
  {
   "fieldname": "engagement",
   "fieldtype": "Link",
   "options": "CA Engagement",
   "label": "Engagement",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "wp_type",
   "fieldtype": "Select",
   "label": "Type",
   "options": "Planning\nLead Schedule\nSupporting Schedule\nTest of Details\nAnalytical Review\nTax Computation\nMemo\nOther",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "audit_head",
   "fieldtype": "Link",
   "options": "CA Audit Head",
   "label": "Audit Head",
   "in_list_view": 1,
   "description": "Blank for engagement-level working papers such as a planning memo."
  },
  {
   "fieldname": "prep_section",
   "fieldtype": "Section Break",
   "label": "Preparation & Review"
  },
  {
   "fieldname": "prepared_by",
   "fieldtype": "Link",
   "options": "User",
   "label": "Prepared By",
   "default": "__user",
   "in_list_view": 1
  },
  {
   "fieldname": "prepared_on",
   "fieldtype": "Date",
   "label": "Prepared On",
   "default": "Today"
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "reviewed_by",
   "fieldtype": "Link",
   "options": "User",
   "label": "Reviewed By"
  },
  {
   "fieldname": "review_status",
   "fieldtype": "Select",
   "label": "Review Status",
   "options": "Not Reviewed\nReviewed - Cleared\nReviewed - Query Raised",
   "default": "Not Reviewed",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Point-level review notes and tick-marks are logged as CA Query Point records against this Working Paper — see CA Query Point.working_paper — not duplicated here."
  },
  {
   "fieldname": "content_section",
   "fieldtype": "Section Break",
   "label": "Content"
  },
  {
   "fieldname": "attached_file",
   "fieldtype": "Attach",
   "label": "Attached File"
  },
  {
   "fieldname": "fs_line_item",
   "fieldtype": "Link",
   "options": "CA Standard FS Line",
   "label": "Ties To FS Line",
   "description": "The standard FS line this schedule's total should agree to, if applicable."
  },
  {
   "fieldname": "column_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "schedule_total",
   "fieldtype": "Currency",
   "label": "Schedule Total (PKR)"
  },
  {
   "fieldname": "ties_to_fs",
   "fieldtype": "Check",
   "label": "Ties Out to FS",
   "read_only": 1,
   "description": "Computed casting/posting check — compares Schedule Total against the linked FS line item's closing balance on the engagement's Source Financial Statement."
  },
  {
   "fieldname": "lineage_section",
   "fieldtype": "Section Break",
   "label": "Version Lineage",
   "collapsible": 1
  },
  {
   "fieldname": "previous_version",
   "fieldtype": "Link",
   "options": "CA Working Paper",
   "label": "Supersedes",
   "description": "Set when a wholesale-replaced file is re-attached as a new record rather than overwriting the prior one. Field-level history is separately covered by Track Changes."
  }
 ],
 "permissions": [
  {"role": "CA Partner", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
  {"role": "CA Manager", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1},
  {"role": "CA Department Supervisor", "read": 1, "write": 1},
  {"role": "CA Job Incharge", "read": 1, "write": 1, "create": 1},
  {"role": "CA Senior Trainee", "read": 1, "write": 1, "create": 1},
  {"role": "CA Junior Trainee", "read": 1, "write": 1, "create": 1},
  {"role": "CA QCR Reviewer", "read": 1}
 ]
}
