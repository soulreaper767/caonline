{
 "doctype": "DocType",
 "name": "CA Engagement Task",
 "module": "CA Audit",
 "engine": "InnoDB",
 "autoname": "hash",
 "title_field": "task_title",
 "sort_field": "modified",
 "sort_order": "DESC",
 "track_changes": 1,
 "fields": [
  {
   "fieldname": "core_section",
   "fieldtype": "Section Break",
   "label": "Task"
  },
  {
   "fieldname": "engagement",
   "fieldtype": "Link",
   "options": "CA Engagement",
   "label": "Engagement",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "task_type",
   "fieldtype": "Select",
   "label": "Task Type",
   "options": "Audit Head\nGeneral Task",
   "default": "Audit Head",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "audit_head",
   "fieldtype": "Link",
   "options": "CA Audit Head",
   "label": "Audit Head",
   "in_list_view": 1,
   "depends_on": "eval:doc.task_type=='Audit Head'",
   "description": "Where this task originated from the Financial Statement's line items — see assignment_manager.bulk_create_tasks_from_fs()."
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "task_title",
   "fieldtype": "Data",
   "label": "Task Title",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "fs_balance_at_assignment",
   "fieldtype": "Currency",
   "label": "FS Balance at Time of Assignment (PKR)",
   "read_only": 1,
   "description": "Snapshot of the combined closing balance of every FS line under this Audit Head, at the moment the task was created — gives the Assignment Manager a materiality-at-a-glance view when deciding who to staff on it."
  },
  {
   "fieldname": "assignment_section",
   "fieldtype": "Section Break",
   "label": "Assignment"
  },
  {
   "fieldname": "assigned_to",
   "fieldtype": "Link",
   "options": "User",
   "label": "Assigned To",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "assigned_grade",
   "fieldtype": "Select",
   "label": "Grade",
   "options": "Junior Trainee\nSenior Trainee\nJob Incharge\nDepartment Supervisor\nManager\nPartner",
   "read_only": 1,
   "description": "Auto-fetched from the assignee's row in CA Engagement.team — a person cannot be assigned a task on an engagement they are not staffed on."
  },
  {
   "fieldname": "reviewer",
   "fieldtype": "Link",
   "options": "User",
   "label": "Reviewer",
   "in_list_view": 1,
   "description": "Must differ from Assigned To — enforced in controller."
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Unassigned\nNot Started\nIn Progress\nUnder Review\nQuery Raised\nCleared",
   "default": "Unassigned",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "priority",
   "fieldtype": "Select",
   "label": "Priority",
   "options": "Low\nMedium\nHigh",
   "default": "Medium",
   "in_list_view": 1
  },
  {
   "fieldname": "due_date",
   "fieldtype": "Date",
   "label": "Due Date",
   "in_list_view": 1
  },
  {
   "fieldname": "time_section",
   "fieldtype": "Section Break",
   "label": "Time"
  },
  {
   "fieldname": "budgeted_hours",
   "fieldtype": "Float",
   "label": "Budgeted Hours",
   "in_list_view": 1
  },
  {
   "fieldname": "actual_hours",
   "fieldtype": "Float",
   "label": "Actual Hours (from Timesheets)",
   "read_only": 1,
   "in_list_view": 1,
   "description": "Rolled up from Timesheet Detail rows where ca_engagement_task = this task — see recompute_actual_hours() and the Timesheet doc_events in hooks.py."
  },
  {
   "fieldname": "column_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "hours_variance",
   "fieldtype": "Float",
   "label": "Variance (Actual - Budgeted)",
   "read_only": 1
  },
  {
   "fieldname": "over_budget",
   "fieldtype": "Check",
   "label": "Over Budget",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "notes_section",
   "fieldtype": "Section Break",
   "label": "Notes"
  },
  {
   "fieldname": "instructions",
   "fieldtype": "Text",
   "label": "Instructions from Assignment Manager"
  },
  {
   "fieldname": "linked_working_paper",
   "fieldtype": "Link",
   "options": "CA Working Paper",
   "label": "Linked Working Paper"
  }
 ],
 "permissions": [
  {"role": "CA Partner", "read": 1, "write": 1, "create": 1, "delete": 1, "report": 1, "export": 1},
  {"role": "CA Manager", "read": 1, "write": 1, "create": 1, "report": 1, "export": 1},
  {"role": "CA Department Supervisor", "read": 1, "write": 1, "report": 1},
  {"role": "CA Job Incharge", "read": 1, "write": 1, "create": 1, "report": 1},
  {"role": "CA Senior Trainee", "read": 1, "write": 1},
  {"role": "CA Junior Trainee", "read": 1, "write": 1}
 ]
}
