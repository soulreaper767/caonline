   "label": "Severity",
   "options": "Breach\nJudgment Required\nDisclosure Gap\nObservation",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Identical option set to CA Query Point.severity by design — CA Engagement.enforce_breach_gate() filters on the literal value 'Breach'."
  },
  {
   "fieldname": "column_break_2",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Open\nUnder Review\nResolved\nAccepted Risk",
   "default": "Open",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "detail_section",
   "fieldtype": "Section Break",
   "label": "Detail"
  },
  {
   "fieldname": "description",
   "fieldtype": "Text",
   "label": "Description",
   "reqd": 1
  },
  {
   "fieldname": "raised_by",
   "fieldtype": "Link",
   "options": "User",
   "label": "Raised By",
   "default": "__user",
   "read_only": 1
  },
  {
   "fieldname": "raised_on",
   "fieldtype": "Date",
   "label": "Raised On",
   "default": "Today"
  },
  {
   "fieldname": "column_break_3",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "resolved_by",
   "fieldtype": "Link",
   "options": "User",
   "label": "Resolved By"
