   "options": "CA Financial Statement",
   "label": "Financial Statement",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "rule_source",
   "fieldtype": "Select",
   "label": "Rule Source",
   "options": "Mechanical Check (Casting/Balancing)\nApplicable Standard Requirement\nIndependence / SoD\nManual Flag",
   "in_list_view": 1
  },
  {
   "fieldname": "applicable_standard",
   "fieldtype": "Link",
   "options": "CA Applicable Standard",
   "label": "Applicable Standard"
