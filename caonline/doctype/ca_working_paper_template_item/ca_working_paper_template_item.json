{
 "doctype": "DocType",
 "name": "CA Working Paper Template Item",
 "module": "CA Core",
 "istable": 1,
 "editable_grid": 1,
 "engine": "InnoDB",
 "fields": [
  {
   "fieldname": "item_name",
   "fieldtype": "Data",
   "label": "Item Name",
   "reqd": 1,
   "in_list_view": 1,
   "description": "e.g. 'Planning Memo', 'Materiality Calculation', 'Bank Confirmation Lead Schedule'."
  },
  {
   "fieldname": "default_wp_type",
   "fieldtype": "Select",
   "label": "Default Working Paper Type",
   "options": "Planning\nLead Schedule\nSupporting Schedule\nTest of Details\nAnalytical Review\nTax Computation\nMemo\nOther",
   "in_list_view": 1
  },
  {
   "fieldname": "default_audit_head",
   "fieldtype": "Link",
   "options": "CA Audit Head",
   "label": "Default Audit Head"
  },
  {
   "fieldname": "is_mandatory",
   "fieldtype": "Check",
   "label": "Mandatory",
   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "sort_order",
   "fieldtype": "Int",
   "label": "Sort Order"
  }
 ],
 "permissions": []
}
