{
 "doctype": "DocType",
 "name": "CA Compliance Checklist Template",
 "module": "CA Compliance",
 "engine": "InnoDB",
 "autoname": "field:template_name",
 "title_field": "template_name",
 "fields": [
  {
   "fieldname": "template_name",
   "fieldtype": "Data",
   "label": "Template Name",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "service_line",
   "fieldtype": "Select",
   "label": "Service Line",
   "options": "\nStatutory Audit\nInternal Audit\nReview Engagement\nAgreed-Upon Procedures\nTax Advisory & Compliance\nTax Litigation\nBookkeeping\nFinancial Statement Compilation\nDue Diligence\nBusiness Valuation\nMerger / Restructuring Advisory\nSECP Secretarial\nForensic Audit\nPayroll Outsourcing\nNPO / Donor Audit\nERP Advisory",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "Leave blank to make this template selectable for any service line."
  },
  {
   "fieldname": "column_break_1",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "is_active",
   "fieldtype": "Check",
   "label": "Active",
   "default": "1",
   "in_list_view": 1
  },
  {
   "fieldname": "items_section",
   "fieldtype": "Section Break",
   "label": "Checklist Items"
  },
  {
   "fieldname": "items",
   "fieldtype": "Table",
   "options": "CA Compliance Checklist Item",
   "label": "Items"
  }
 ],
 "permissions": [
  {"role": "CA Partner", "read": 1, "write": 1, "create": 1, "delete": 1},
  {"role": "CA Manager", "read": 1, "write": 1, "create": 1},
  {"role": "CA Department Supervisor", "read": 1},
  {"role": "CA Job Incharge", "read": 1}
 ]
}
